    "id": "model-loading"
   },
   "source": [
    "## 3. Model Loading and Initialization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "load-model"
   },
   "outputs": [],
   "source": [
    "from transformers import AutoModelForCausalLM, AutoProcessor, AutoTokenizer\n",
    "import torch\n",
    "\n",
    "# Model configuration - Choose your preferred model\n",
    "MODEL_OPTIONS = {\n",
    "    \"VideoLLaMA3-7B\": \"DAMO-NLP-SG/VideoLLaMA3-7B\",\n",
    "    \"VideoLLaMA3-2B\": \"DAMO-NLP-SG/VideoLLaMA3-2B\",\n",
    "    \"VideoLLaMA3-7B-Image\": \"DAMO-NLP-SG/VideoLLaMA3-7B-Image\",\n",
    "    \"VideoLLaMA3-2B-Image\": \"DAMO-NLP-SG/VideoLLaMA3-2B-Image\"\n",
    "}\n",
    "\n",
    "# Select model (change this to test different models)\n",
    "selected_model = \"VideoLLaMA3-2B\"  # Start with smaller model for faster testing\n",
    "model_path = MODEL_OPTIONS[selected_model]\n",
    "\n",
    "print(f\"Loading model: {selected_model}\")\n",
    "print(f\"Model path: {model_path}\")\n",
    "\n",
    "# Load model with optimized settings for GPU\n",
    "try:\n",
    "    model = AutoModelForCausalLM.from_pretrained(\n",
    "        model_path,\n",
    "        torch_dtype=torch.bfloat16,\n",
    "        device_map=\"auto\",\n",
    "        trust_remote_code=True,\n",
    "        attn_implementation=\"flash_attention_2\"\n",
    "    ).to(device)\n",
    "    \n",
    "    # Load processor with error handling\n",
    "    try:\n",
    "        processor = AutoProcessor.from_pretrained(model_path, trust_remote_code=True)\n",
    "    except ImportError as e:\n",
    "        print(f\"⚠️  AutoProcessor failed, using tokenizer instead: {e}\")\n",
    "        print(\"Note: Some video processing features may be limited\")\n",
    "        processor = AutoTokenizer.from_pretrained(model_path, trust_remote_code=True)\n",
    "        \n",
    "    print(f\"✅ Model loaded successfully on {device}!\")\n",
    "    print(f\"Model parameters: {model.num_parameters():,}\")\n",
    "    \n",
    "except Exception as e:\n",
    "    print(f\"❌ Error loading model: {e}\")\n",
    "    print(\"\\n🔧 Troubleshooting steps:\")\n",
    "    print(\"1. Restart the runtime: Runtime → Restart runtime\")\n",
    "    print(\"2. Try a different model (e.g., VideoLLaMA3-2B-Image)\")\n",
    "    print(\"3. Check if all dependencies installed correctly\")\n",
    "    print(\"4. Consider using CPU if GPU memory is insufficient\")\n",
    "    raise e"
   ]
