   "cell_type": "markdown",
   "metadata": {
    "id": "video-processing"
   },
   "source": [
    "## 4. Video Loading and Preprocessing Utilities"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "video-utils"
   },
   "outputs": [],
   "source": [
    "import cv2\n",
    "import numpy as np\n",
    "from PIL import Image\n",
    "import matplotlib.pyplot as plt\n",
    "from decord import VideoReader\n",
    "import torch\n",
    "from typing import List, Union\n",
    "\n",
    "def load_video_frames(video_path: str, max_frames: int = 64, target_size: tuple = (224, 224)) -> List[Image.Image]:\n",
    "    \"\"\"\n",
    "    Load video frames using decord for efficient video processing.\n",
    "    \n",
    "    Args:\n",
    "        video_path: Path to video file\n",
    "        max_frames: Maximum number of frames to extract\n",
    "        target_size: Target size for each frame (height, width)\n",
    "        \n",
    "    Returns:\n",
    "        List of PIL Images\n",
    "    \"\"\"\n",
    "    try:\n",
    "        # Use decord for efficient video reading\n",
    "        vr = VideoReader(video_path)\n",
    "        total_frames = len(vr)\n",
    "        \n",
    "        # Calculate frame indices to sample evenly\n",
    "        if total_frames <= max_frames:\n",
    "            frame_indices = list(range(total_frames))\n",
    "        else:\n",
    "            step = total_frames / max_frames\n",
    "            frame_indices = [int(i * step) for i in range(max_frames)]\n",
    "        \n",
    "        frames = []\n",
    "        for idx in frame_indices:\n",
    "            frame = vr[idx].asnumpy()\n",
    "            frame = cv2.resize(frame, target_size)\n",
    "            frame = Image.fromarray(frame)\n",
    "            frames.append(frame)\n",
    "            \n",
    "        return frames\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"Error loading video {video_path}: {e}\")\n",
    "        return []\n",
    "\n",
    "def download_sample_video() -> str:\n",
    "    \"\"\"\n",
    "    Download a sample video for testing.\n",
    "    \"\"\"\n",
    "    import gdown\n",
    "    import os\n",
    "    \n",
    "    # Create sample_videos directory\n",
    "    os.makedirs(\"sample_videos\", exist_ok=True)\n",
    "    \n",
    "    # Download a sample video (you can replace this URL with any sample video)\n",
    "    video_url = \"https://sample-videos.com/zip/10/mp4/360/SampleVideo_360x240_1mb.mp4\"\n",
    "    output_path = \"sample_videos/sample_video.mp4\"\n",
    "    \n",
    "    if not os.path.exists(output_path):\n",
    "        print(\"Downloading sample video...\")\n",
    "        gdown.download(video_url, output_path, quiet=False)\n",
    "        print(f\"✅ Sample video downloaded to: {output_path}\")\n",
    "    else:\n",
    "        print(f\"✅ Sample video already exists: {output_path}\")\n",
    "        \n",
    "    return output_path\n",
    "\n",
    "def display_video_frames(frames: List[Image.Image], max_display: int = 8):\n",
    "    \"\"\"\n",
    "    Display video frames in a grid.\n",
    "    \"\"\"\n",
    "    num_frames = min(len(frames), max_display)\n",
    "    cols = 4\n",
    "    rows = (num_frames + cols - 1) // cols\n",
    "    \n",
    "    fig, axes = plt.subplots(rows, cols, figsize=(15, 3*rows))\n",
    "    if rows == 1:\n",
    "        axes = axes.reshape(1, -1)\n",
    "        \n",
    "    for i in range(num_frames):\n",
    "        row, col = i // cols, i % cols\n",
    "        axes[row, col].imshow(frames[i])\n",
    "        axes[row, col].set_title(f\"Frame {i+1}\")\n",
    "        axes[row, col].axis('off')\n",
    "    \n",
    "    # Hide empty subplots\n",
    "    for i in range(num_frames, rows * cols):\n",
    "        row, col = i // cols, i % cols\n",
    "        axes[row, col].axis('off')\n",
    "        \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "print(\"✅ Video processing utilities loaded!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "inference-function"
   },
   "source": [
    "## 5. Inference Function"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "inference-func"
   },
   "outputs": [],
   "source": [
    "def run_inference(model, processor, video_path: str = None, images: List[Image.Image] = None, \n",
    "                 question: str = \"What is happening in this video?\", max_tokens: int = 200):\n",
    "    \"\"\"\n",
    "    Run inference on video or images with VideoLLaMA3.\n",
    "    \n",
    "    Args:\n",
    "        model: Loaded VideoLLaMA3 model\n",
    "        processor: Model processor\n",
    "        video_path: Path to video file (for video models)\n",
    "        images: List of PIL Images (for image models)\n",
    "        question: Question to ask about the content\n",
    "        max_tokens: Maximum number of tokens to generate\n",
    "        \n",
    "    Returns:\n",
    "        Generated response\n",
    "    \"\"\"\n",
    "    try:\n",
    "        # Prepare conversation format\n",
    "        conversation = [\n",
    "            {\n",
    "                \"role\": \"system\",\n",
    "                \"content\": \"You are a helpful assistant for analyzing videos and images.\"\n",
    "            },\n",
    "            {\n",
    "                \"role\": \"user\",\n",
    "                \"content\": [\n",
    "                    {\"type\": \"text\", \"text\": question}\n",
    "                ]\n",
    "            }\n",
    "        ]\n",
    "        \n",
    "        # Add video or images to conversation\n",
    "        if video_path and not selected_model.endswith(\"Image\"):\n",
    "            # Load video frames\n",
    "            frames = load_video_frames(video_path, max_frames=32)\n",
    "            if frames:\n",
    "                conversation[1][\"content\"].insert(0, {\n",
    "                    \"type\": \"video\", \n",
    "                    \"video\": frames\n",
    "                })\n",
    "                print(f\"✅ Loaded {len(frames)} frames from video\")\n",
    "            else:\n",
    "                print(\"❌ Failed to load video frames\")\n",
    "                return None\n",
    "                \n",
    "        elif images and selected_model.endswith(\"Image\"):\n",
    "            conversation[1][\"content\"].insert(0, {\n",
    "                \"type\": \"image\", \n",
    "                \"image\": images[0] if len(images) == 1 else images\n",
    "            })\n",
    "            print(f\"✅ Loaded {len(images)} image(s)\")\n",
    "        else:\n",
    "            print(\"❌ Please provide either video_path (for video models) or images (for image models)\")\n",
    "            return None\n",
    "            \n",
    "        # Process inputs\n",
    "        inputs = processor(\n",
    "            conversation=conversation,\n",
    "            add_system_prompt=True,\n",
    "            add_generation_prompt=True,\n",
    "            return_tensors=\"pt\"\n",
    "        ).to(device)\n",
    "        \n",
    "        # Move inputs to GPU if needed\n",
    "        if \"pixel_values\" in inputs:\n",
    "            inputs[\"pixel_values\"] = inputs[\"pixel_values\"].to(device, torch.bfloat16)\n",
    "        \n",
    "        # Generate response\n",
    "        print(f\"🤖 Generating response to: '{question}'\")\n",
    "        with torch.no_grad():\n",
    "            output_ids = model.generate(\n",
    "                **inputs,\n",
    "                max_new_tokens=max_tokens,\n",
    "                do_sample=True,\n",
    "                temperature=0.7,\n",
    "                top_p=0.9,\n",
    "                use_cache=True\n",
    "            )\n",
    "        \n",
    "        # Decode response\n",
    "        response = processor.batch_decode(\n",
    "            output_ids[:, inputs[\"input_ids\"].shape[1]:], \n",
    "            skip_special_tokens=True\n",
    "        )[0]\n",
    "        \n",
    "        return response.strip()\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"❌ Error during inference: {e}\")\n",
    "        return None\n",
    "\n",
    "print(\"✅ Inference function ready!\")"
   ]
  },
