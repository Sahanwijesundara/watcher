    "### 6.4 Performance and Memory Test"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "performance-test"
   },
   "outputs": [],
   "source": [
    "# Test memory usage and performance\n",
    "def test_memory_usage():\n",
    "    \"\"\"Test GPU memory usage during inference\"\"\"\n",
    "    if torch.cuda.is_available():\n",
    "        torch.cuda.empty_cache()\n",
    "        initial_memory = torch.cuda.memory_allocated(0) / 1024**3\n",
    "        \n",
    "        # Run a test inference\n",
    "        response = run_inference(\n",
    "            model, processor, \n",
    "            video_path=video_path, \n",
    "            question=\"What colors dominate this video?\", \n",
    "            max_tokens=50\n",
    "        )\n",
    "        \n",
    "        final_memory = torch.cuda.memory_allocated(0) / 1024**3\n",
    "        print(f\"\\n📊 Memory Usage:\")\n",
    "        print(f\"Initial GPU memory: {initial_memory:.2f} GB\")\n",
    "        print(f\"Final GPU memory: {final_memory:.2f} GB\")\n",
    "        print(f\"Memory used: {final_memory - initial_memory:.2f} GB\")\n",
    "        \n",
    "        return response\n",
    "    else:\n",
    "        print(\"❌ CUDA not available for memory testing\")\n",
    "        return None\n",
    "\n",
    "# Run performance test\n",
